# Public values only. These are safe to expose in the browser.
# Find them in Supabase > Project Settings > API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY

# NEVER put any of the following in a VITE_ variable or commit them.
# Set them as Supabase Edge Function secrets instead (see docs/DEPLOYMENT.md):
#   SUPABASE_SERVICE_ROLE_KEY   (provided automatically to Edge Functions)
#   CRON_SECRET                 (>= 32 random characters; protects reconcile/notification endpoints)
#   MAPRELAD_API_KEY            (only once Maprelad documentation + sandbox credentials exist)
#   MAPRELAD_WEBHOOK_SECRET     (only once Maprelad's documented signature method is implemented)
#   RESEND_API_KEY, EMAIL_FROM  (optional; without them notifications are marked not_configured)
